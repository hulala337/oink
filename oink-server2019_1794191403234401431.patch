--- /tmp/oink-orig/oink-main/.github/workflows/build-windows-msi.yml	1970-01-01 08:00:00
+++ /tmp/oink-work/oink-main/.github/workflows/build-windows-msi.yml	2026-11-09 00:10:22
@@ -0,0 +1,70 @@
+name: Build unsigned Windows x64 MSI (in-house)
+
+# Windows Server 2019 support build. The product's own packager refuses to run
+# outside an x64 Windows host, so this workflow uses a Windows runner instead of
+# signing/publishing anything: it only produces an unsigned per-machine MSI.
+on:
+  workflow_dispatch:
+    inputs:
+      build:
+        description: In-house build number (must be a positive integer)
+        required: true
+        default: '1'
+
+permissions:
+  contents: read
+
+jobs:
+  msi:
+    runs-on: windows-2022
+    timeout-minutes: 120
+    steps:
+      - name: Check out the full history
+        uses: actions/checkout@v4
+        with:
+          # In-house package notes and the source-commit provenance input need
+          # real history; a shallow clone makes package.py refuse the build.
+          fetch-depth: 0
+
+      - name: Install the pinned Node toolchain
+        uses: actions/setup-node@v4
+        with:
+          node-version: '24.14.1'
+
+      - name: Pin npm to the version the packager requires
+        run: npm install --global npm@11.11.0
+
+      - name: Install the pinned Rust toolchain
+        run: rustup toolchain install 1.99.0 --profile minimal --component rustfmt --component clippy
+
+      - name: Report the toolchain the build will see
+        run: |
+          rustc --version
+          node --version
+          npm --version
+          python --version
+          dotnet --list-runtimes
+
+      - name: Build binaries and the MSI
+        env:
+          # WiX 5 ships as a net6.0 assembly; let it run on a newer runtime when
+          # the image no longer carries the .NET 6 runtime.
+          DOTNET_ROLL_FORWARD: LatestMajor
+          DOTNET_CLI_TELEMETRY_OPTOUT: '1'
+        run: |
+          python build-support/package.py `
+            --platform windows `
+            --build ${{ inputs.build }} `
+            --output-root "$env:RUNNER_TEMP\oink-packages" `
+            --tool-cache "$env:RUNNER_TEMP\oink-tools"
+
+      - name: Show what was produced
+        run: Get-ChildItem -Recurse "$env:RUNNER_TEMP\oink-packages" -Include *.msi | Format-List FullName, Length
+
+      - name: Upload the MSI
+        uses: actions/upload-artifact@v4
+        with:
+          name: oink-windows-x64-msi
+          path: ${{ runner.temp }}/oink-packages/**/*.msi
+          if-no-files-found: error
+          retention-days: 14
